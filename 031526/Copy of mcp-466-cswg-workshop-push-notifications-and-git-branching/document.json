        },
        {
          "Type": "listItem",
          "Level": 1,
          "Elements": [
            {
              "Type": "text",
              "Content": "git difftool {local branch} {remote branch}  \n",
              "Style": {}
            }
          ]
        },
        {
          "Type": "listItem",
          "Level": 2,
          "Elements": [
            {
              "Type": "text",
              "Content": "shows differences between local and remote branches\n",
              "Style": {}
            }
          ]
        },
        {
          "Type": "listItem",
          "Level": 1,
          "Elements": [
            {
              "Type": "text",
              "Content": "git merge {remote branch}\n",
              "Style": {}
            }
          ]
        },
        {
          "Type": "listItem",
          "Level": 2,
          "Elements": [
            {
              "Type": "text",
              "Content": "merges remote changes into local branch, potentially creating merge conflicts\n",
              "Style": {}
            }
          ]
        },
        {
          "Type": "listItem",
          "Level": 1,
          "Elements": [
            {
              "Type": "text",
